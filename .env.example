# Sao chép thành .env.local rồi điền (file .env.local không bị commit)
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Bí mật — chỉ dùng cho script cài đặt, KHÔNG đưa lên web
SUPABASE_SERVICE_ROLE_KEY=
# Mật khẩu database (đặt lúc tạo project)
SUPABASE_DB_PASSWORD=
# Nút Connect → Session pooler → dán nguyên URI, cứ để chữ [YOUR-PASSWORD]: script tự thay bằng mật khẩu ở trên
SUPABASE_DB_URL=
